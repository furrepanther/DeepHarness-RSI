class MemoryFabricTerminalWriteError(RuntimeError):
    """A durable write reached an explicit terminal state without a result."""

    def __init__(self, *, job_id: str, status: str, detail: str) -> None:
        self.job_id = job_id
        self.status = status
        self.detail = detail
        super().__init__(
            f"Memory Fabric job {job_id} reached {status}: {detail[:1200]}"
        )

    @property
    def retryable_transport_failure(self) -> bool:
        detail = self.detail.lower()
        if self.status == "failed_terminal" and not detail.strip():
            # A terminal receipt with no diagnostic is an unknown backend
            # outcome, not proof of a semantic rejection. The caller has
            # already performed exact reconciliation; allow its one derived
            # idempotency-key repair attempt, then fail closed if that fails.
            return True
        return any(
            marker in detail
            for marker in (
                "server error '500",
                "server error '502",
                "server error '503",
                "server error '504",
                "closedresourceerror",
                "remote disconnected",
                "connection reset",
                "connection refused",
                "timed out",
                "timeout",
                "temporarily unavailable",
                "embedding",
            )
        )


def _terminal_detail(payload: dict[str, Any]) -> str:
    """Preserve an explicitly empty backend diagnostic as empty evidence."""
    for field in ("last_error", "error", "result"):
        if field not in payload:
            continue
        value = payload[field]
        if value is None:
            continue
        return str(value)
    return str(payload)


def load_json(path: Path) -> Any:
    with path.open("r", encoding="utf-8") as f:
        return json.load(f)


def load_json_or_error(path: Path, *, documentation: bool = False) -> tuple[Any | None, str]:
    try:
        result = load_json(path)
        if not isinstance(result, dict):
            raise ValueError("review output must be a JSON object")
        if documentation:
            if not isinstance(result.get("suggested_comments"), list):
                raise ValueError("documentation output lacks suggested_comments list")
        elif not isinstance(result.get("merge_decision"), dict) or result["merge_decision"].get("decision") not in {"block", "insufficient_evidence", "no_blocking_defect_found"} or not isinstance(result.get("findings"), list):
            raise ValueError("review output lacks valid merge_decision/findings")
        if not documentation and result["merge_decision"]["decision"] == "no_blocking_defect_found":
            if any(isinstance(f, dict) and f.get("blocking") is True for f in result["findings"]):
                result["merge_decision"] = {**result["merge_decision"], "decision": "block",
                                            "reason": "reviewer supplied a blocking finding"}
            else:
                materials = result.get("materials_reviewed")
                if not isinstance(materials, list) or not materials or any(
                    not isinstance(item, dict) or item.get("status") != "fully_reviewed" for item in materials
                ):
                    result["merge_decision"] = {**result["merge_decision"], "decision": "insufficient_evidence",
                                                "reason": "review materials missing, inaccessible or not fully reviewed"}
                else:
                    # This wrapper has no trusted reviewer-side receipt verifier yet.
                    # Reviewer assertions and producer-side hashes cannot prove delivery.
                    result["merge_decision"] = {**result["merge_decision"], "decision": "insufficient_evidence",
                                                "reason": "trusted reviewer-side evidence receipt unavailable"}
        return result, ""
    except Exception as exc:
        return None, f"{type(exc).__name__}: {exc}"


def write_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def runtime_prompt_from_doc(prompt_doc: str) -> str:
    match = re.search(r"```text\s*(.*?)\s*```", prompt_doc, flags=re.DOTALL | re.IGNORECASE)
    if match:
        return match.group(1).strip()
    return prompt_doc.strip()


def compact_text(value: Any, max_chars: int) -> str:
    text = value if isinstance(value, str) else json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True)
    if max_chars <= 0 or len(text) <= max_chars:
        return text
    marker = f"\n\n[truncated to {max_chars} chars for local review context]\n"
    keep = max(0, max_chars - len(marker))
    return text[:keep].rstrip() + marker


def safe_review_chars(requested: int) -> int:
    """Return a lane budget within the measured reviewer compatibility cap."""
    return min(max(int(requested), 800), SAFE_LANE_REVIEW_CHARS)


def deep_copy_json(value: Any) -> Any:
    return json.loads(json.dumps(value, ensure_ascii=False))


