def runtime_prompt_from_doc(prompt_doc: str) -> str:
    match = re.search(r"```text\s*(.*?)\s*```", prompt_doc, flags=re.DOTALL | re.IGNORECASE)
    prompt = match.group(1).strip() if match else prompt_doc.strip()
    return f"{prompt}\n\n{REQUIREMENT_ANCHOR_INSTRUCTION}"


def normalize_router_base_url(value: str) -> str:
    parsed = urllib.parse.urlparse(value)
    try:
        port = parsed.port
    except ValueError:
        port = None
    if parsed.scheme != "http" or parsed.hostname != "127.0.0.1" or port != 11888:
        raise SystemExit(f"Refusing non-router base URL: {value}")
    path = parsed.path.rstrip("/")
    if path not in {"", "/v1"}:
        raise SystemExit(f"Refusing router URL path outside /v1: {value}")
    return "http://127.0.0.1:11888/v1"


def local_router_adapter_identity_is_valid(adapter_id: Any, adapter_version: Any) -> bool:
    """Accept only the router-owned adapter contract used by local evidence."""
    return (
        str(adapter_id or "").strip() == EXPECTED_LOCAL_ROUTER_ADAPTER_ID
        and str(adapter_version or "").strip() == EXPECTED_LOCAL_ROUTER_ADAPTER_VERSION
    )


def local_router_route_evidence_is_valid(route: dict[str, Any]) -> bool:
    """Require the complete source-owned local route evidence contract."""
    return (
        route.get("router_url") == DEFAULT_ROUTER_BASE
        and bool(route.get("route_header_consistent"))
        and bool(route.get("adapter_identity_verified"))
        and route.get("request_id") != "unknown"
        and not bool(route.get("cloud_used"))
        and not bool(route.get("truncated"))
    )


class RejectInferenceRedirects(urllib.request.HTTPRedirectHandler):
    """Never forward an inference request or credential to a redirect target."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise urllib.error.HTTPError(req.full_url, code, "inference redirects are refused", headers, fp)


class ReviewEvidenceFailure(RuntimeError):
    """A local review request ended without a defensible completion signal."""

    def __init__(self, reason: str, evidence: dict[str, Any]):
        self.reason = reason
        self.evidence = evidence
        super().__init__(reason)


def _probe_local_json(url: str) -> dict[str, Any]:
    request = urllib.request.Request(url, headers={"Accept": "application/json"}, method="GET")
    opener = urllib.request.build_opener(RejectInferenceRedirects())
    try:
        with opener.open(request, timeout=EVIDENCE_PROBE_TIMEOUT_S) as response:
            body = response.read(EVIDENCE_MAX_BODY_BYTES + 1)
            status = int(response.status)
        if len(body) > EVIDENCE_MAX_BODY_BYTES:
            return {"ok": False, "status": status, "reason": "probe_body_cap_exceeded"}
        payload = json.loads(body.decode("utf-8"))
        return {"ok": status == 200, "status": status, "payload": payload}
    except Exception as exc:  # noqa: BLE001 - probe failures are evidence, not success
        return {"ok": False, "status": None, "reason": f"{type(exc).__name__}: {exc}"[:240]}


def _probe_local_metrics(url: str = "http://127.0.0.1:11434/metrics") -> dict[str, Any]:
    request = urllib.request.Request(url, headers={"Accept": "text/plain"}, method="GET")
    opener = urllib.request.build_opener(RejectInferenceRedirects())
    wanted = {
        "requests_processing",
        "requests_deferred",
        "prompt_tokens_total",
        "tokens_predicted_total",
        "n_decode_total",
    }
    try:
        with opener.open(request, timeout=EVIDENCE_PROBE_TIMEOUT_S) as response:
            body = response.read(EVIDENCE_MAX_BODY_BYTES + 1)
            status = int(response.status)
        if len(body) > EVIDENCE_MAX_BODY_BYTES:
            return {"ok": False, "status": status, "reason": "probe_body_cap_exceeded"}
        values: dict[str, float] = {}
        for raw_line in body.decode("utf-8", errors="replace").splitlines():
            line = raw_line.strip()
            if not line or line.startswith("#"):
                continue
            name, _, raw_value = line.partition(" ")
            name = name.split("{", 1)[0]
            if name not in wanted:
                continue
            try:
                values[name] = float(raw_value.strip())
            except ValueError:
                continue
        return {"ok": status == 200, "status": status, "values": values}
    except Exception as exc:  # noqa: BLE001 - probe failures are evidence, not success
        return {"ok": False, "status": None, "reason": f"{type(exc).__name__}: {exc}"[:240]}


def _safe_int(value: Any) -> int:
    try:
        return max(int(value), 0)
    except (TypeError, ValueError):
        return 0


def collect_review_evidence(router_base_url: str) -> dict[str, Any]:
    """Collect bounded runtime evidence without reading prompts or whole logs."""
    root = router_base_url.rstrip("/")
    if root.endswith("/v1"):
        root = root[:-3]
    health = _probe_local_json(root + "/health")
    queue_probe = _probe_local_json(root + "/queue?include_worker_slots=true")
    slots_probe = _probe_local_json(root + "/slots")
    metrics_probe = _probe_local_metrics()

    queue_payload = queue_probe.get("payload") if isinstance(queue_probe.get("payload"), dict) else {}
    state = queue_payload.get("state") if isinstance(queue_payload.get("state"), dict) else {}
    worker_slots = queue_payload.get("worker_slots") if isinstance(queue_payload.get("worker_slots"), dict) else {}
    limits = queue_payload.get("limits") if isinstance(queue_payload.get("limits"), dict) else {}
    slots_payload = slots_probe.get("payload") if isinstance(slots_probe.get("payload"), list) else []
    metrics = metrics_probe.get("values") if isinstance(metrics_probe.get("values"), dict) else {}
    return {
        "health_ok": bool(health.get("ok")),
        "health_status": health.get("status"),
        "queue_ok": bool(queue_probe.get("ok")),
        "slots_ok": bool(slots_probe.get("ok")),
        "metrics_ok": bool(metrics_probe.get("ok")),
        "resident_slots": _safe_int(limits.get("resident_slots")),
        "user_max_in_flight": _safe_int(limits.get("user_max_in_flight")),
        "max_queued_requests": _safe_int(limits.get("max_queued_requests")),
        "queue_timeout_s": _safe_int(limits.get("queue_timeout_s")),
        "active_global": _safe_int(state.get("active_global")),
        "active_user": _safe_int(state.get("active_user")),
        "active_background": _safe_int(state.get("active_background")),
        "queued_global": _safe_int(state.get("queued_global")),
        "queued_user": _safe_int(state.get("queued_user")),
        "queued_background": _safe_int(state.get("queued_background")),
        "total_admitted": _safe_int(state.get("total_admitted")),
        "total_released": _safe_int(state.get("total_released")),
        "worker_busy": _safe_int(worker_slots.get("busy")),
        "worker_total": _safe_int(worker_slots.get("total")),
        "slot_busy": sum(1 for slot in slots_payload if isinstance(slot, dict) and slot.get("is_processing")),
        "slot_total": len(slots_payload),
        "slot_progress": [
            {
                "id": _safe_int(slot.get("id")),
                "id_task": _safe_int(slot.get("id_task")),
                "is_processing": bool(slot.get("is_processing")),
                "n_prompt_tokens_processed": _safe_int(slot.get("n_prompt_tokens_processed")),
                "n_decoded": _safe_int(
                    (slot.get("next_token") or [{}])[0].get("n_decoded")
                    if isinstance(slot.get("next_token"), list)
                    and slot.get("next_token")
                    and isinstance(slot.get("next_token")[0], dict)
                    else 0
                ),
            }
            for slot in slots_payload
            if isinstance(slot, dict)
        ],
        "requests_processing": _safe_int(metrics.get("requests_processing")),
        "requests_deferred": _safe_int(metrics.get("requests_deferred")),
        "prompt_tokens_total": _safe_int(metrics.get("prompt_tokens_total")),
        "tokens_predicted_total": _safe_int(metrics.get("tokens_predicted_total")),
        "n_decode_total": _safe_int(metrics.get("n_decode_total")),
        "probe_errors": [
            str(probe.get("reason"))[:240]
            for probe in (health, queue_probe, slots_probe, metrics_probe)
            if not probe.get("ok") and probe.get("reason")
        ][:4],
    }


def _evidence_has_activity(evidence: dict[str, Any]) -> bool:
    return any(
        _safe_int(evidence.get(key)) > 0
        for key in ("active_global", "queued_global", "worker_busy", "slot_busy", "requests_processing", "requests_deferred")
    )


def _evidence_counters_advanced(before: dict[str, Any], current: dict[str, Any]) -> bool:
    return any(
        _safe_int(current.get(key)) > _safe_int(before.get(key))
        for key in ("total_admitted", "total_released", "prompt_tokens_total", "tokens_predicted_total", "n_decode_total")
    )


def _evidence_slots_advanced(before: dict[str, Any], current: dict[str, Any]) -> bool:
    """Detect post-start worker progress without trusting global busy state.

    A slot that was already active at request start is not evidence that this
    request owns the work.  A new task assignment or advancing slot counters
    is a bounded, post-start activity signal; unchanged activity is not.
    """
    before_slots = before.get("slot_progress")
    current_slots = current.get("slot_progress")
    if not isinstance(before_slots, list) or not isinstance(current_slots, list):
        return False

    before_by_key = {
        (item.get("id"), item.get("id_task")): item
        for item in before_slots
        if isinstance(item, dict)
    }
    for item in current_slots:
        if not isinstance(item, dict) or not item.get("is_processing"):
            continue
        key = (item.get("id"), item.get("id_task"))
        previous = before_by_key.get(key)
        if previous is None:
            return True
        for field in ("n_prompt_tokens_processed", "n_decoded"):
            if _safe_int(item.get(field)) > _safe_int(previous.get(field)):
                return True
    return False


def _evidence_progressed(before: dict[str, Any], current: dict[str, Any]) -> bool:
    """Return true only for measurable activity after the prior observation."""
    return _evidence_counters_advanced(before, current) or _evidence_slots_advanced(before, current)


def _evidence_service_unavailable(evidence: dict[str, Any]) -> bool:
    return not any(bool(evidence.get(key)) for key in ("health_ok", "queue_ok", "slots_ok", "metrics_ok"))


def _capacity_wait_signature(evidence: dict[str, Any]) -> tuple[Any, ...]:
    """Return only bounded, non-sensitive capacity state for progress reporting."""
    return (
        bool(evidence.get("health_ok")),
        bool(evidence.get("queue_ok")),
        _safe_int(evidence.get("active_global")),
        _safe_int(evidence.get("resident_slots")),
        _safe_int(evidence.get("active_user")),
        _safe_int(evidence.get("user_max_in_flight")),
        _safe_int(evidence.get("queued_global")),
        _safe_int(evidence.get("queued_user")),
    )


def _local_capacity_available(evidence: dict[str, Any]) -> bool:
    """Admit only when both global and per-user queue capacity are observable."""
    return (
        bool(evidence.get("health_ok"))
        and bool(evidence.get("queue_ok"))
        and _safe_int(evidence.get("resident_slots")) > 0
        and _safe_int(evidence.get("user_max_in_flight")) > 0
        and _safe_int(evidence.get("active_global")) < _safe_int(evidence.get("resident_slots"))
        and _safe_int(evidence.get("active_user")) < _safe_int(evidence.get("user_max_in_flight"))
        and _safe_int(evidence.get("queued_global")) == 0
        and _safe_int(evidence.get("queued_user")) == 0
    )


def wait_for_local_capacity(router_base_url: str, evidence_poll_s: float) -> dict[str, Any]:
    """Wait for attributable router capacity without imposing a wall-clock cap."""
    if evidence_poll_s <= 0:
        raise ValueError("evidence_poll_s must be positive")

    observations: list[dict[str, Any]] = []
    missing_queue_probes = 0
    previous_signature: tuple[Any, ...] | None = None
    while True:
        current = collect_review_evidence(router_base_url)
        observations.append(current)
        del observations[:-EVIDENCE_MAX_OBSERVATIONS]
        signature = _capacity_wait_signature(current)
        if signature != previous_signature:
            print(
                "local router capacity wait: "
                f"health={int(bool(current.get('health_ok')))} "
                f"queue={int(bool(current.get('queue_ok')))} "
                f"active={_safe_int(current.get('active_global'))}/{_safe_int(current.get('resident_slots'))} "
                f"user={_safe_int(current.get('active_user'))}/{_safe_int(current.get('user_max_in_flight'))} "
                f"queued={_safe_int(current.get('queued_global'))}/{_safe_int(current.get('queued_user'))}",
                file=sys.stderr,
            )
            previous_signature = signature

        if _evidence_service_unavailable(current):
            raise ReviewEvidenceFailure(
                "service_unavailable",
                {"observations": observations, "capacity_required": True},
            )
        if not current.get("queue_ok"):
            missing_queue_probes += 1
            if missing_queue_probes >= CAPACITY_QUEUE_MISSING_PROBES:
                raise ReviewEvidenceFailure(
                    "capacity_evidence_unavailable",
                    {"observations": observations, "capacity_required": True},
                )
        else:
            missing_queue_probes = 0
            if _local_capacity_available(current):
                return current
        time.sleep(evidence_poll_s)


def local_http_json_with_evidence(
    url: str,
    payload: dict[str, Any],
    router_base_url: str,
    evidence_poll_s: float,
) -> tuple[dict[str, Any], dict[str, str], bytes, bytes]:
    """Wait for local inference using runtime evidence, never a total duration cap."""
    if evidence_poll_s <= 0:
        raise ValueError("evidence_poll_s must be positive")

    baseline = wait_for_local_capacity(router_base_url, evidence_poll_s)
    result_queue: queue.Queue[tuple[str, Any]] = queue.Queue(maxsize=1)

    def run_request() -> None:
        try:
            result_queue.put(("result", http_json(url, payload)))
        except Exception as exc:  # pass the actual transport/model failure to the caller
            result_queue.put(("error", exc))

    request_thread = threading.Thread(target=run_request, name="review-inference-request", daemon=True)
    request_thread.start()
    observations: list[dict[str, Any]] = []
    idle_observations = 0
    activity_seen = False
    previous = baseline

    while True:
        try:
            kind, value = result_queue.get(timeout=evidence_poll_s)
        except queue.Empty:
            current = collect_review_evidence(router_base_url)
            observations.append(current)
            del observations[:-EVIDENCE_MAX_OBSERVATIONS]
            if _evidence_service_unavailable(current):
                raise ReviewEvidenceFailure(
                    "service_unavailable",
                    {"baseline": baseline, "observations": observations},
                )

            progress_seen = _evidence_progressed(previous, current)
            activity_transition = not _evidence_has_activity(previous) and _evidence_has_activity(current)
            if progress_seen or activity_transition:
                activity_seen = True
            if progress_seen or activity_transition:
                idle_observations = 0
            else:
                idle_observations += 1

            previous = current

            queue_pending = (
                _safe_int(current.get("queued_global")) > 0
                or _safe_int(current.get("queued_user")) > 0
                or _safe_int(current.get("active_global")) >= _safe_int(current.get("resident_slots")) > 0
            )
            if idle_observations >= EVIDENCE_IDLE_PROBES_REQUIRED and not queue_pending:
                raise ReviewEvidenceFailure(
                    "transport_ambiguous",
                    {
                        "baseline": baseline,
                        "observations": observations,
                        "idle_probe_count": idle_observations,
                        "request_thread_alive": request_thread.is_alive(),
                        "activity_seen": activity_seen,
                        "explanation": "request remained pending without post-start queue, slot, or metric progress",
                    },
                )
            continue

        if kind == "error":
            raise value
        return value


def http_json_with_headers(
    url: str,
    payload: dict[str, Any],
    extra_headers: dict[str, str] | None = None,
) -> tuple[dict[str, Any], dict[str, str], bytes, bytes]:
    if url != DEFAULT_ROUTER_BASE + "/chat/completions":
        raise ValueError("review inference must use the local router chat endpoint")
    body = json.dumps(payload, ensure_ascii=True, separators=(",", ":")).encode("utf-8")
    headers = {"Content-Type": "application/json", "Accept": "application/json"}
    if extra_headers:
        headers.update(extra_headers)
    req = urllib.request.Request(
        url,
        data=body,
        headers=headers,
        method="POST",
    )
    opener = urllib.request.build_opener(RejectInferenceRedirects())
    with opener.open(req) as resp:
        response_body = resp.read()
        headers = {k.lower(): v for k, v in resp.headers.items()}
    try:
        parsed = json.loads(response_body.decode("utf-8"))
    except json.JSONDecodeError as exc:
        preview = decode_body(response_body)[:500]
        raise ValueError(f"router response was not JSON: {exc}; preview={preview!r}") from exc
    if not isinstance(parsed, dict):
        raise ValueError("router response JSON was not an object")
    return parsed, headers, body, response_body


def http_json(url: str, payload: dict[str, Any]) -> tuple[dict[str, Any], dict[str, str], bytes, bytes]:
    return http_json_with_headers(url, payload, {"X-Inference-Route": "local"})


def decode_body(body: bytes) -> str:
    return body.decode("utf-8", errors="replace")


def explain_http_error(
    exc: urllib.error.HTTPError,
    request_body: bytes,
    elapsed: float,
    response_body: bytes | None = None,
) -> dict[str, Any]:
    if response_body is None:
        response_body = getattr(exc, "_primus_response_body", None)
    if response_body is None:
        response_body = exc.read(EVIDENCE_MAX_BODY_BYTES + 1)
    response_body_truncated = len(response_body) > EVIDENCE_MAX_BODY_BYTES
    response_body = response_body[:EVIDENCE_MAX_BODY_BYTES]
    headers = {k.lower(): v for k, v in exc.headers.items()}
    text = decode_body(response_body).strip()
    parsed: Any = None
    if text:
        try:
            parsed = json.loads(text)
        except json.JSONDecodeError:
            parsed = None
    error = parsed.get("error") if isinstance(parsed, dict) and isinstance(parsed.get("error"), dict) else {}
    return {
        "status": exc.code,
        "reason": exc.reason,
        "headers": headers,
        "error_type": error.get("type", ""),
        "fallback_reason": error.get("fallback_reason") or headers.get("x-inference-fallback-reason", ""),
        "router_action": error.get("router_action", ""),
        "message": error.get("message") or text,
        "body": parsed if parsed is not None else text,
        "request_hash": sha256_bytes(request_body),
        "response_hash": sha256_bytes(response_body),
        "elapsed_s": round(elapsed, 3),
        "response_body_truncated": response_body_truncated,
    }


def http_error_is_queue_timeout(exc: urllib.error.HTTPError) -> bool:
    """Recognize only the router's explicit capacity timeout, then restore the body."""
    response_body = exc.read(EVIDENCE_MAX_BODY_BYTES + 1)
    exc._primus_response_body = response_body
    exc.fp = io.BytesIO(response_body)
    try:
        parsed = json.loads(response_body[:EVIDENCE_MAX_BODY_BYTES].decode("utf-8", errors="replace"))
    except json.JSONDecodeError:
        parsed = None
    text = (
        json.dumps(parsed, ensure_ascii=True)
        if parsed is not None
        else response_body[:EVIDENCE_MAX_BODY_BYTES].decode("utf-8", errors="replace")
    )
    return exc.code == 503 and "queue timeout waiting for user capacity" in text.lower()


def write_raw_error(path: Path | None, error_report: dict[str, Any]) -> None:
    if not path:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(error_report, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def _loads_checker_json(value: str) -> Any:
    def merge_duplicate_findings_arrays(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
        merged: dict[str, Any] = {}
        for key, item in pairs:
            if (
                key == "findings"
                and isinstance(merged.get(key), list)
                and isinstance(item, list)
            ):
                merged[key].extend(item)
                continue
            merged[key] = item
        return merged

    return json.loads(value, object_pairs_hook=merge_duplicate_findings_arrays)


def extract_json_object(text: str) -> dict[str, Any]:
    stripped = text.strip()
    if stripped.startswith("```"):
        stripped = re.sub(r"^```(?:json)?\s*", "", stripped, flags=re.IGNORECASE)
        stripped = re.sub(r"\s*```$", "", stripped)
    try:
        value = _loads_checker_json(stripped)
    except json.JSONDecodeError:
        repaired = re.sub(r'},\s*("id"\s*:)', r'},{\1', stripped)
        repaired = re.sub(
            r'("findings"\s*:\s*\[[^\]]*?}),\s*"findings"\s*:\s*\[',
            r'\1,',
            repaired,
        )
        if repaired == stripped:
            raise
        value = _loads_checker_json(repaired)
    if not isinstance(value, dict):
        raise ValueError("checker output JSON was not an object")
    return value


def ensure_list(value: Any) -> list[Any]:
    return value if isinstance(value, list) else []


def normalize_severity(value: Any) -> str:
    text = str(value or "Medium").strip().title()
    return text if text in {"Critical", "High", "Medium", "Low"} else "Medium"


FORBIDDEN_INFERENCE_ENDPOINT_RE = re.compile(
    r"(127\.0\.0\.1:(?:11434|11441)\b|localhost:(?:11434|11441)\b|api\.openai\.com|api\.anthropic\.com|generativelanguage\.googleapis\.com|openrouter\.ai|localhost:\d+/v1/chat/completions|127\.0\.0\.1:\d+/v1/chat/completions)",
    flags=re.IGNORECASE,
)


def forbidden_inference_endpoints(text: str) -> list[str]:
    matches = []
    current_path = ""
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if line.startswith("diff --git "):
            parts = line.split()
            current_path = parts[-1][2:] if len(parts) >= 4 and parts[-1].startswith("b/") else parts[-1] if parts else ""
            continue
        lower_path = current_path.lower()
        if lower_path.endswith((".md", ".rst", ".txt")):
            continue
        content = line[1:].lstrip() if line.startswith("+") else line
        if content.startswith(("#", "//", "*")):
            continue
        if "do not use" in content.lower() or "old code used" in content.lower() or "documentation only" in content.lower():
            continue
        for match in FORBIDDEN_INFERENCE_ENDPOINT_RE.findall(content):
            endpoint = str(match)
            if "127.0.0.1:11888" in endpoint or "localhost:11888" in endpoint:
                continue
            matches.append(endpoint)
    return sorted(set(matches))


def packet_requirements(packet: dict[str, Any]) -> list[dict[str, str]]:
    raw = packet.get("ACCEPTANCE_CRITERIA")
    if isinstance(raw, list):
        items = [str(x) for x in raw if str(x).strip()]
    else:
        text = str(raw or "").strip()
        items = [line.strip(" -") for line in text.splitlines() if line.strip(" -")] or ([text] if text else [])
    if not items:
        items = ["Review packet did not provide explicit acceptance criteria."]
    return [
        {"id": f"R{i+1}", "requirement": item, "source": "ACCEPTANCE_CRITERIA", "status": "clear" if item else "missing_evidence"}
        for i, item in enumerate(items)
    ]


def scaffold_materials(packet: dict[str, Any]) -> list[dict[str, str]]:
    materials = []
    for key, typ in [
        ("TASK", "requirement"),
        ("ACCEPTANCE_CRITERIA", "requirement"),
        ("DIFF_OR_FILES", "diff"),
        ("TESTS", "test"),
        ("KNOWN_CONSTRAINTS", "requirement"),
        ("OUT_OF_SCOPE", "requirement"),
        ("PROVENANCE", "artifact"),
    ]:
        value = packet.get(key)
        empty = value in (None, "", [], {})
        materials.append({
            "id": key,
            "type": typ,
            "status": "missing" if empty else "partially_reviewed",
            "notes": "present in packet; reviewer did not attest review" if not empty else "missing or empty in review packet",
        })
    return materials


def scaffold_tests(packet: dict[str, Any], requirements: list[dict[str, str]]) -> list[dict[str, Any]]:
    tests = str(packet.get("TESTS") or "").strip()
    if not tests:
        return []
    return [{
        "id": "T1",
        "assertion": "Provided tests were reviewed; wrapper could not deterministically extract individual assertions.",
        "source": "TESTS",
        "covers_requirements": [],
        "strength": "unclear",
    }]


def scaffold_coverage(requirements: list[dict[str, str]], tests: list[dict[str, Any]]) -> list[dict[str, Any]]:
    coverage = []
    test_ids = [str(t.get("id", "T1")) for t in tests if isinstance(t, dict)]
    for req in requirements:
        coverage.append({
            "requirement_id": req["id"],
            "covered_by_tests": test_ids,
            "coverage": "unclear" if tests else "not_covered",
            "implementation_evidence": "checker model did not provide requirement-specific implementation evidence",
            "test_evidence": "checker model did not provide requirement-specific test evidence" if tests else "no tests provided",
            "gap": "coverage scaffolded by wrapper because model omitted acceptance_coverage",
            "no_block_justification": "",
        })
    return coverage


def map_defects_to_findings(defects: Any) -> list[dict[str, Any]]:
    findings = []
    if not isinstance(defects, list):
        return findings
    for i, defect in enumerate(defects, 1):
        if not isinstance(defect, dict):
            defect = {"description": str(defect)}
        severity = normalize_severity(defect.get("severity"))
        title = str(defect.get("title") or defect.get("category") or "model-reported defect")
        desc = str(defect.get("description") or title)
        evidence = str(defect.get("evidence") or desc)
        findings.append({
            "id": f"F{i}",
            "severity": severity,
            "location": str(defect.get("location") or evidence[:180] or "reviewed artifact"),
            "blocking": severity in {"Critical", "High"},
            "observed_evidence": evidence,
            "failure_scenario": desc,
            "why_not_noise": "Mapped from checker model defect with concrete evidence.",
            "required_fix": str(defect.get("required_fix") or desc),
        })
    return findings


def normalize_requirements(value: Any, packet: dict[str, Any]) -> list[dict[str, str]]:
    if not isinstance(value, list) or not value:
        return [{**item, "status": "missing_evidence"} for item in packet_requirements(packet)]
    normalized = []
    for i, item in enumerate(value, 1):
        if not isinstance(item, dict):
            item = {"requirement": str(item), "source": "model"}
        req_id = str(item.get("id") or f"R{i}")
        if not re.match(r"^R[0-9]+$", req_id):
            req_id = f"R{i}"
        status = str(item.get("status") or "missing_evidence")
        if status not in {"clear", "ambiguous", "missing_evidence"}:
            status = "missing_evidence"
        requirement = str(item.get("requirement") or item.get("text") or "")
        if requirement:
            normalized.append({
                "id": req_id,
                "requirement": requirement,
                "source": str(item.get("source") or "model"),
                "status": status,
            })
    return normalized or [{**item, "status": "missing_evidence"} for item in packet_requirements(packet)]


def normalize_tests(value: Any, packet: dict[str, Any], requirements: list[dict[str, str]]) -> list[dict[str, Any]]:
    if not isinstance(value, list) or not value:
        return scaffold_tests(packet, requirements)
    normalized = []
    valid_strength = {"strong", "weak", "missing", "unclear"}
    for i, item in enumerate(value, 1):
        if not isinstance(item, dict):
            item = {"assertion": str(item), "source": "model", "strength": "unclear"}
        test_id = str(item.get("id") or f"T{i}")
        if not re.match(r"^T[0-9]+$", test_id):
            test_id = f"T{i}"
        covers = item.get("covers_requirements")
        if not isinstance(covers, list):
            covers = []
        covers = [str(x) for x in covers if re.match(r"^R[0-9]+$", str(x))]
        strength = str(item.get("strength") or "unclear")
        if strength not in valid_strength:
            strength = "unclear"
        normalized.append({
            "id": test_id,
            "assertion": str(item.get("assertion") or item.get("text") or ""),
            "source": str(item.get("source") or "model"),
            "covers_requirements": covers,
            "strength": strength,
        })
    return normalized or scaffold_tests(packet, requirements)


def normalize_materials(value: Any, packet: dict[str, Any]) -> list[dict[str, str]]:
    valid_types = {"file", "diff", "test", "log", "requirement", "artifact", "prompt", "route_evidence", "other"}
    valid_status = {"fully_reviewed", "partially_reviewed", "missing", "inaccessible", "possibly_truncated"}
    if not isinstance(value, list) or not value:
        return scaffold_materials(packet)
    normalized = []
    for i, item in enumerate(value, 1):
        if not isinstance(item, dict):
            item = {"id": f"M{i}", "type": "other", "status": "partially_reviewed", "notes": str(item)}
        typ = str(item.get("type") or "other")
        status = str(item.get("status") or "partially_reviewed")
        normalized.append({
            "id": str(item.get("id") or f"M{i}"),
            "type": typ if typ in valid_types else "other",
            "status": status if status in valid_status else "partially_reviewed",
            "notes": str(item.get("notes") or ""),
        })
    return normalized or scaffold_materials(packet)


def normalize_findings(value: Any) -> list[dict[str, Any]]:
    if not isinstance(value, list):
        return []
    findings = []
    for i, finding in enumerate(value, 1):
        if not isinstance(finding, dict):
            finding = {"description": str(finding)}
        severity = normalize_severity(finding.get("severity"))
        desc = str(
            finding.get("failure_scenario")
            or finding.get("description")
            or finding.get("title")
            or finding.get("observed_evidence")
            or "model-reported finding"
        )
        evidence = str(finding.get("observed_evidence") or finding.get("evidence") or desc)
        blocking = finding.get("blocking")
        if not isinstance(blocking, bool):
            blocking = severity in {"Critical", "High"}
        findings.append({
            "id": f"F{i}",
            "severity": severity,
            "location": str(finding.get("location") or evidence[:180] or "reviewed artifact"),
            "blocking": blocking,
            "observed_evidence": evidence,
            "failure_scenario": desc,
            "why_not_noise": str(finding.get("why_not_noise") or "Concrete model finding tied to reviewed artifact behavior."),
            "required_fix": str(finding.get("required_fix") or finding.get("fix") or desc),
        })
    return findings


def normalize_coverage(value: Any, requirements: list[dict[str, str]], tests: list[dict[str, Any]]) -> list[dict[str, Any]]:
    if not isinstance(value, list) or not all(isinstance(item, dict) for item in value):
        return scaffold_coverage(requirements, tests)
    normalized = []
    test_ids = [str(t.get("id", "T1")) for t in tests]
    valid_coverage = {"covered", "weakly_covered", "not_covered", "unclear"}
    for i, item in enumerate(value, 1):
        req_id = str(item.get("requirement_id") or f"R{i}")
        if not re.match(r"^R[0-9]+$", req_id):
            req_id = f"R{i}"
        covered = item.get("covered_by_tests")
        if not isinstance(covered, list):
            covered = test_ids
        covered = [str(x) for x in covered if re.match(r"^T[0-9]+$", str(x))]
        coverage = str(item.get("coverage") or "unclear")
        if coverage not in valid_coverage:
            coverage = "unclear"
        normalized.append({
            "requirement_id": req_id,
            "covered_by_tests": covered,
            "coverage": coverage,
            "implementation_evidence": str(item.get("implementation_evidence") or ""),
            "test_evidence": str(item.get("test_evidence") or ""),
            "gap": str(item.get("gap") or ""),
            "no_block_justification": str(item.get("no_block_justification") or ""),
        })
    return normalized


def normalize_prompt_injections(value: Any) -> list[dict[str, Any]]:
    if not isinstance(value, list):
        return []
    normalized = []
    for item in value[:10]:
        if not isinstance(item, dict):
            item = {"observed_text_or_summary": str(item)}
        summary = str(item.get("observed_text_or_summary") or item.get("summary") or item.get("text") or "")
        source = str(item.get("source") or "reviewed artifact")
        if summary:
            normalized.append({"source": source, "observed_text_or_summary": summary, "ignored": True})
    return normalized


def detect_prompt_injections(packet: dict[str, Any], findings: list[dict[str, Any]]) -> list[dict[str, Any]]:
    indicators = ("system:", "developer:", "user:", "reviewer", "ignore", "approve", "no findings", "output no")
    detected = []
    for source, text in iter_string_leaves(packet, "review_packet"):
        lower = text.lower()
        if any(indicator in lower for indicator in indicators) and any(term in lower for term in ("reviewer", "system:", "no findings", "approve")):
            detected.append({
                "source": source,
                "observed_text_or_summary": "artifact contains text resembling reviewer/system instructions",
                "ignored": True,
            })
    if not detected:
        for finding in findings:
            text = " ".join(str(finding.get(key, "")) for key in ("observed_evidence", "failure_scenario", "required_fix")).lower()
            if "prompt injection" in text or "reviewer instruction" in text or "system:" in text:
                detected.append({
                    "source": "model finding",
                    "observed_text_or_summary": "model finding described artifact-contained reviewer/system instruction",
                    "ignored": True,
                })
                break
    return detected[:5]


def normalize_test_gaps(value: Any) -> list[dict[str, Any]]:
    if not isinstance(value, list):
        return []
    normalized = []
    for i, item in enumerate(value[:10], 1):
        if not isinstance(item, dict):
            item = {"gap": str(item)}
        req_id = str(item.get("requirement_id") or f"R{i}")
        if not re.match(r"^R[0-9]+$", req_id):
            req_id = f"R{i}"
        gap = str(item.get("gap") or item.get("description") or "")
        if gap:
            normalized.append({"requirement_id": req_id, "gap": gap, "blocking": bool(item.get("blocking", False))})
    return normalized


def apply_deterministic_finding_guards(findings: list[dict[str, Any]], packet: dict[str, Any]) -> tuple[list[dict[str, Any]], list[str]]:
    """Downgrade narrow known hallucination patterns without hiding real gaps."""
    diff = stringify_section(packet.get("DIFF_OR_FILES", ""))
    tests = stringify_section(packet.get("TESTS", ""))
    reviewed_text = diff + "\n" + tests
    guarded: list[dict[str, Any]] = []
    notes: list[str] = []
    sqlite_context_commit = "with sqlite3.connect" in diff and ".commit()" in diff
    has_raise_for_status = ".raise_for_status()" in diff or "raise_for_status()" in diff
    uses_router_11888 = "127.0.0.1:11888/v1" in reviewed_text
    forbidden_endpoints = forbidden_inference_endpoints(reviewed_text)
    for finding in findings:
        evidence = " ".join(
            str(finding.get(key, ""))
            for key in ("observed_evidence", "failure_scenario", "required_fix")
        ).lower()
        sqlite_transaction_claim = (
            sqlite_context_commit
            and ("sqlite3.connect" in evidence or "context manager" in evidence or "commit" in evidence)
            and any(term in evidence for term in ("begin", "commit", "transaction", "isolation", "atomic", "context manager"))
        )
        if sqlite_transaction_claim:
            finding["severity"] = "Medium"
            finding["blocking"] = False
            finding["why_not_noise"] = "Guard downgraded a known SQLite transaction false-positive signature; reviewer adjudication still required."
            notes.append("downgraded unsupported sqlite transaction finding; diff uses sqlite3 context manager and explicit commit")
        http_error_claim = (
            has_raise_for_status
            and any(term in evidence for term in ("non-200", "non 200", "http error", "raise", "status"))
            and any(term in evidence for term in ("does not", "doesn't", "missing", "only calls", "cannot verify"))
        )
        if http_error_claim:
            finding["severity"] = "Medium"
            finding["blocking"] = False
            finding["why_not_noise"] = "Guard downgraded a known HTTP error-handling false-positive signature; reviewer adjudication still required."
            notes.append("downgraded unsupported HTTP error-handling finding; diff visibly calls raise_for_status()")
        cloud_signal_clean_claim = (
            "cloud_fallback_required" in reviewed_text
            and "x-inference-cloud-required" in reviewed_text
            and uses_router_11888
            and not forbidden_endpoints
            and any(term in evidence for term in ("router evidence", "router args", "global state", "mock", "r.json", "non-json", "cloud_required"))
            and any(term in evidence for term in ("missing", "no ", "without", "crash", "fail"))
        )
        if cloud_signal_clean_claim:
            finding["severity"] = "Low"
            finding["blocking"] = False
            finding["why_not_noise"] = "Guard downgraded unsupported cloud-handoff false-positive; packet shows router-only cloud-required propagation and no direct provider call."
            notes.append("downgraded unsupported cloud-required propagation finding; executable path stays on router")
        router_bypass_claim = (
            uses_router_11888
            and not forbidden_endpoints
            and "11888" in evidence
            and any(term in evidence for term in ("bypass", "direct llama", "instead of using the local inference router", "direct backend"))
        )
        if router_bypass_claim:
            finding["severity"] = "Medium"
            finding["blocking"] = False
            finding["why_not_noise"] = "Guard downgraded unsupported router-bypass claim; 127.0.0.1:11888/v1 is the local inference router."
            notes.append("downgraded unsupported router-bypass finding; diff uses local inference router 11888/v1")
        guarded.append(finding)
    severity_rank = {"Critical": 0, "High": 1, "Medium": 2, "Low": 3}
    guarded.sort(key=lambda f: (not bool(f.get("blocking")), severity_rank.get(str(f.get("severity")), 4)))
    for i, finding in enumerate(guarded, 1):
        finding["id"] = f"F{i}"
    return guarded, notes


def append_deterministic_policy_findings(findings: list[dict[str, Any]], packet: dict[str, Any]) -> list[dict[str, Any]]:
    """Add objective, packet-derived findings for recurring checker misses."""
    text = "\n".join(
        stringify_section(packet.get(key, ""))
        for key in ("TASK", "ACCEPTANCE_CRITERIA", "KNOWN_CONSTRAINTS")
    ).lower()
    diff = stringify_section(packet.get("DIFF_OR_FILES", ""))
    tests = stringify_section(packet.get("TESTS", ""))
    reviewed_text = diff + "\n" + tests
    tests_lower = tests.lower()
    existing = "\n".join(
        " ".join(str(finding.get(key, "")) for key in ("observed_evidence", "failure_scenario", "required_fix", "location"))
        for finding in findings
        if isinstance(finding, dict)
    ).lower()

    def add(severity: str, observed: str, scenario: str, fix: str) -> None:
        nonlocal existing
        if observed.lower() in existing or scenario.lower() in existing:
            return
        findings.append({
            "id": f"F{len(findings)+1}",
            "severity": severity,
            "location": "TESTS" if "test" in scenario.lower() else "reviewed packet",
            "blocking": severity in {"Critical", "High"},
            "observed_evidence": observed,
            "failure_scenario": scenario,
            "why_not_noise": "Deterministic wrapper finding from explicit packet evidence.",
            "required_fix": fix,
        })
        existing += "\n" + observed.lower() + "\n" + scenario.lower()

    placeholder_test = (
        bool(re.search(r"(?m)^\s*(pass|\.{3})\s*(#.*)?$", tests))
        and ("def test" in tests_lower or "test_" in tests_lower)
        and any(term in text for term in ("test", "assert", "verify", "acceptance", "parameterized", "sql"))
    )
    if placeholder_test:
        add(
            "High",
            "TESTS contain a placeholder pass in a test surface.",
            "Required behavior may be accepted without an assertion, creating a false pass.",
            "Replace placeholder pass with assertions that exercise the stated acceptance criteria.",
        )

    idempotence_required = any(term in text for term in ("idempot", "running ensure twice", "exactly once", "no duplicate", "duplicate"))
    call_count = len([
        line for line in tests_lower.splitlines()
        if "ensure_line(" in line and not line.lstrip().startswith("def ")
    ])
    if idempotence_required and 0 < call_count < 2:
        existing_without_fix = existing
        add(
            "High",
            "Idempotence acceptance is present, but TESTS call ensure_line fewer than two times.",
            "Duplicate-append behavior can ship because the repeated-run requirement is untested.",
            "Add a repeated-call test that asserts exactly one final config line.",
        )
        gaps_marker = "fewer than two times"
        if gaps_marker not in existing_without_fix:
            findings.append({
                "id": f"F{len(findings)+1}",
                "severity": "High",
                "location": "TESTS",
                "blocking": True,
                "observed_evidence": "TESTS call ensure_line fewer than two times.",
                "failure_scenario": "The second invocation duplicate-prevention requirement is untested.",
                "why_not_noise": "A single-call test cannot prove idempotence.",
                "required_fix": "Call ensure_line twice and assert exactly one final line.",
            })
            existing += "\n" + gaps_marker

    cuda_guard_required = "cuda 12" in text or "cuda 12-era" in text
    diff_lower = diff.lower()
    has_cuda_guard = any(term in diff_lower for term in ("cuda 12", "cuda-12", "cuda_12", "cuda 13", "build_cuda_13", "version check"))
    if cuda_guard_required and not has_cuda_guard:
        add(
            "Critical",
            "Acceptance forbids CUDA 12-era binaries, but the diff has no CUDA/build-version guard.",
            "A stale CUDA-era binary can be promoted without detection.",
            "Add an explicit CUDA/build provenance check before promotion.",
        )

    disruption_notice_required = "disruption" in text and any(term in text for term in ("notify", "notice", "notification"))
    stops_service = "systemctl stop" in diff_lower
    has_disruption_notice = "core-service-disruption-notice" in diff_lower or "disruption notice" in diff_lower or "notification step" in diff_lower
    if disruption_notice_required and stops_service and not has_disruption_notice:
        add(
            "Critical",
            "Diff calls systemctl stop without a disruption notice or notification step.",
            "Core service can be stopped unannounced, disrupting local and peer work.",
            "Call /usr/production/core-service-disruption-notice start before stop and restored after health checks.",
        )
    wrong_shared_repo_build_path = "/linuxdata/github/llama.cpp" in diff_lower and "/local_build" in text
    if wrong_shared_repo_build_path:
        add(
            "Critical",
            "Diff uses /linuxdata/Github/llama.cpp instead of the required /local_build workspace.",
            "Promotion can reuse shared-repo or stale build artifacts instead of the canonical local build.",
            "Build in /local_build/antigravity/llama.cpp and promote only that verified artifact.",
        )
        if findings:
            findings[0]["observed_evidence"] = str(findings[0].get("observed_evidence", "")) + " Also observed /linuxdata/Github/llama.cpp where /local_build is required."

    # Do not treat a security comment or acceptance criterion mentioning
    # caller-controlled evidence as proof of a vulnerability.  Only flag an
    # actual data-flow assignment from packet/request input, or an unconditional
    # verification claim that bypasses the router-owned validation helper.
    spoofed_route_evidence = (
        "route_evidence" in diff_lower
        and (
            re.search(
                r"(?:route_evidence|route_evidence_verified)\s*[:=]\s*(?:request|payload|packet|raw_input|input)\b",
                diff_lower,
            )
            is not None
            or re.search(
                r"(?:request|payload|packet|review_packet|raw_input|input)\s*(?:\.get\(|\[)\s*['\"]route_evidence",
                diff_lower,
            )
            is not None
            or re.search(r"route_evidence_verified\s*[:=]\s*true\b", diff_lower) is not None
        )
    )
    if spoofed_route_evidence:
        add(
            "Critical",
            "route_evidence is derived from caller-controlled input without a router-owned validation boundary.",
            "A caller can inject route evidence that the checker accepts as verified.",
            "Derive route evidence from the local router response and fail closed unless its source-owned identity and verification fields pass.",
        )

    forbidden_endpoints = forbidden_inference_endpoints(reviewed_text)
    if forbidden_endpoints:
        add(
            "Critical",
            "Reviewed artifacts contain non-router inference endpoint(s): " + ", ".join(forbidden_endpoints[:3]),
            "Runtime inference can bypass the local inference router or silently fall back to a direct/cloud backend.",
            "Route inference only through http://127.0.0.1:11888/v1 and remove direct backend/provider fallback paths.",
        )

    async_post_without_await = (
        "async def" in diff_lower
        and ".post(" in diff_lower
        and "await " not in diff_lower
    )
    if async_post_without_await:
        add(
            "High",
            "Async function calls client.post without await.",
            "The caller can receive success before the network send completes or fails.",
            "Await the network send and propagate or return failures.",
        )

    swallowed_success = (
        "except exception" in diff_lower
        and "pass" in diff_lower
        and ("'ok': true" in diff_lower or '"ok": true' in diff_lower)
    )
    if swallowed_success:
        add(
            "Critical",
            "Exception handler swallows failure and returns {'ok': True}.",
            "Callers cannot observe send failures and may treat failed work as successful.",
            "Do not swallow the exception; return or raise a failure state.",
        )

    severity_rank = {"Critical": 0, "High": 1, "Medium": 2, "Low": 3}
    findings.sort(key=lambda f: (not bool(f.get("blocking")), severity_rank.get(str(f.get("severity")), 4)))
    for i, finding in enumerate(findings[:3], 1):
        finding["id"] = f"F{i}"
    return findings[:3]


def apply_policy_gates(result: dict[str, Any], packet: dict[str, Any], finish_reason: str, *, reviewer_receipt_verified: bool = False) -> None:
    provenance = packet.get("PROVENANCE", {}) if isinstance(packet.get("PROVENANCE"), dict) else {}
    missing_required = [
        key for key in ("TASK", "ACCEPTANCE_CRITERIA", "DIFF_OR_FILES", "TESTS", "KNOWN_CONSTRAINTS", "PROVENANCE")
        if packet.get(key) in (None, "", [], {})
    ]
    no_block = result.get("merge_decision", {}).get("decision") == "no_blocking_defect_found"
    unsafe_no_block_reasons = []
    if reviewer_receipt_verified is not True:
        unsafe_no_block_reasons.append("reviewer evidence receipt is not verified")
    if missing_required:
        unsafe_no_block_reasons.append("required packet sections missing: " + ",".join(missing_required))
    if not provenance.get("provenance_verified"):
        unsafe_no_block_reasons.append("provenance not verified")
    if not provenance.get("complete_packet"):
        unsafe_no_block_reasons.append("packet not marked complete")
    diff = packet.get("DIFF_OR_FILES")
    if any(
        any(line.lstrip().startswith("complete_evidence_index=yes;") for line in text.splitlines())
        for _, text in iter_string_leaves(diff, "DIFF_OR_FILES")
    ):
        # The checker has no verified reviewer-side pointer retrieval channel.
        # An index and preview alone do not prove the model saw full evidence.
        unsafe_no_block_reasons.append("compacted evidence index was not resolved for the reviewer")
    route_evidence = result.get("route_evidence", {}) if isinstance(result.get("route_evidence"), dict) else {}
    if finish_reason in {"length", "content_filter"} or route_evidence.get("truncated"):
        unsafe_no_block_reasons.append(f"model output truncated or filtered: {finish_reason or 'unknown'}")
    if route_evidence.get("cloud_used"):
        unsafe_no_block_reasons.append("cloud route used without signed promotion policy")
    if route_evidence.get("route_evidence_verified") is False:
        unsafe_no_block_reasons.append("route evidence was not verified")
    high_risk_missing_evidence = (
        "DIFF_OR_FILES" in missing_required
        or "TESTS" in missing_required
        or not provenance.get("provenance_verified")
        or not provenance.get("complete_packet")
    )
    if high_risk_missing_evidence:
        result["merge_decision"]["decision"] = "insufficient_evidence"
        result["merge_decision"]["reason"] = "insufficient evidence: " + "; ".join(unsafe_no_block_reasons or ["required implementation/test evidence missing"])
        for finding in result.get("findings", []):
            if isinstance(finding, dict):
                finding["blocking"] = False
                finding["why_not_noise"] = "Packet lacks verified implementation/test evidence; treat model defect claims as unproven until evidence is supplied."
        gaps = result.get("test_assertion_gaps") if isinstance(result.get("test_assertion_gaps"), list) else []
        gaps.append({
            "requirement_id": "R1",
            "gap": "review packet is missing verified diff/test evidence, so blocker claims cannot be validated",
            "blocking": True,
        })
        result["test_assertion_gaps"] = gaps
    coverage = result.get("acceptance_coverage") if isinstance(result.get("acceptance_coverage"), list) else []
    requirements = result.get("requirements_extracted") if isinstance(result.get("requirements_extracted"), list) else []
    requirement_ids = [str(item.get("id") or "") for item in requirements if isinstance(item, dict)]
    coverage_ids = [str(item.get("requirement_id") or "") for item in coverage if isinstance(item, dict)]
    expected_requirements = {
        item["id"]: " ".join(item["requirement"].split())
        for item in packet_requirements(packet)
    }
    actual_requirements = {
        str(item.get("id") or ""): " ".join(str(item.get("requirement") or "").split())
        for item in requirements if isinstance(item, dict)
    }
    missing_coverage = (
        not requirement_ids
        or len(requirement_ids) != len(requirements)
        or len(requirement_ids) != len(set(requirement_ids))
        or len(coverage_ids) != len(coverage)
        or len(coverage_ids) != len(set(coverage_ids))
        or set(coverage_ids) != set(requirement_ids)
        or any(actual_requirements.get(key) != text for key, text in expected_requirements.items())
        or any(item.get("status") != "clear" for item in requirements if isinstance(item, dict))
    )
    for item in coverage:
        if not isinstance(item, dict):
            missing_coverage = True
            continue
        impl = str(item.get("implementation_evidence", "")).strip()
        test = str(item.get("test_evidence", "")).strip()
        scaffolded = "checker model did not provide" in impl or "checker model did not provide" in test
        if item.get("coverage") != "covered" or not impl or not test or scaffolded:
            missing_coverage = True
    if no_block and missing_coverage:
        unsafe_no_block_reasons.append("acceptance criteria lack complete verified coverage")
    materials = result.get("materials_reviewed")
    if no_block:
        if not isinstance(materials, list) or not materials:
            unsafe_no_block_reasons.append("reviewer did not report reviewed materials")
        else:
            if any(not isinstance(item, dict) or item.get("status") != "fully_reviewed" for item in materials):
                unsafe_no_block_reasons.append("reviewed materials are missing, inaccessible, partial or truncated")
            required = {"DIFF_OR_FILES": {"diff", "file"}, "TESTS": {"test"}}
            for material_id, valid_types in required.items():
                matches = [item for item in materials if isinstance(item, dict) and item.get("id") == material_id]
                if len(matches) != 1 or matches[0].get("type") not in valid_types or matches[0].get("status") != "fully_reviewed":
                    unsafe_no_block_reasons.append(f"required material lacks a unique full review attestation: {material_id}")
    checks = result.get("adversarial_checks_performed", {})
    if no_block and isinstance(checks, dict) and not str(checks.get("why_no_block_is_justified", "")).strip():
        unsafe_no_block_reasons.append("missing why_no_block_is_justified")
    if no_block and unsafe_no_block_reasons:
        result["merge_decision"]["decision"] = "insufficient_evidence"
        result["merge_decision"]["reason"] = "unsafe no-block rejected: " + "; ".join(unsafe_no_block_reasons)
    if finish_reason in {"length", "content_filter"}:
        result["test_assertion_gaps"].append({
            "requirement_id": "R1",
            "gap": "checker model output was truncated or filtered; result may be missing decisive findings",
            "blocking": True,
        })


def strip_top_level_to_schema(result: dict[str, Any]) -> dict[str, Any]:
    allowed = {
        "schema_version", "prompt_version", "review_packet", "route_evidence", "materials_reviewed",
        "requirements_extracted", "test_assertions_extracted", "acceptance_coverage",
        "adversarial_checks_performed", "prompt_injection_attempts", "findings",
        "test_assertion_gaps", "merge_decision", "residual_risks",
    }
    return {k: v for k, v in result.items() if k in allowed}


def coerce_result(result: dict[str, Any], *, packet: dict[str, Any], packet_id: str, packet_hash: str, route: dict[str, Any], finish_reason: str, reviewer_receipt_verified: bool = False) -> dict[str, Any]:
    result["schema_version"] = SCHEMA_VERSION
    result["prompt_version"] = PROMPT_VERSION
    result["review_packet"] = {
        "packet_id": packet_id,
        "packet_hash": packet_hash,
        "repo_or_scope": str(packet.get("PROVENANCE", {}).get("repo_or_scope") or "unknown"),
        "base_revision": str(packet.get("PROVENANCE", {}).get("base_revision") or "unknown"),
        "provenance_verified": bool(packet.get("PROVENANCE", {}).get("provenance_verified")),
        "complete_packet": bool(packet.get("PROVENANCE", {}).get("complete_packet")),
    }
    result["route_evidence"] = route
    requirements = normalize_requirements(result.get("requirements_extracted"), packet)
    result["requirements_extracted"] = requirements

    tests = normalize_tests(result.get("test_assertions_extracted"), packet, requirements)
    result["test_assertions_extracted"] = tests

    materials = normalize_materials(result.get("materials_reviewed"), packet)
    result["materials_reviewed"] = materials

    coverage = normalize_coverage(result.get("acceptance_coverage"), requirements, tests)
    result["acceptance_coverage"] = coverage

    result["findings"] = normalize_findings(result.get("findings"))
    if not result.get("findings"):
        result["findings"] = map_defects_to_findings(result.get("defects"))
    result["findings"], guard_notes = apply_deterministic_finding_guards(result.get("findings", []), packet)
    result["findings"] = append_deterministic_policy_findings(result.get("findings", []), packet)
    reviewed_text_for_noise_cap = stringify_section(packet.get("DIFF_OR_FILES", "")) + "\n" + stringify_section(packet.get("TESTS", ""))
    if (
        "cloud_fallback_required" in reviewed_text_for_noise_cap
        and "x-inference-cloud-required" in reviewed_text_for_noise_cap
        and "127.0.0.1:11888" in reviewed_text_for_noise_cap
        and not any(f.get("blocking") for f in result.get("findings", []) if isinstance(f, dict))
    ):
        result["findings"] = result["findings"][:1]
    result["prompt_injection_attempts"] = normalize_prompt_injections(result.get("prompt_injection_attempts"))
    if not result["prompt_injection_attempts"]:
        result["prompt_injection_attempts"] = detect_prompt_injections(packet, result.get("findings", []))
    result["test_assertion_gaps"] = normalize_test_gaps(result.get("test_assertion_gaps"))
    residual_risks = result.get("residual_risks")
    if not isinstance(residual_risks, list):
        residual_risks = []
    result["residual_risks"] = list(dict.fromkeys(residual_risks + [
        f"{note}; deterministic checker guard applied; tune prompt/corpus with reviewer evidence"
        for note in guard_notes
    ]))
    reviewed_text_for_residual = stringify_section(packet.get("DIFF_OR_FILES", ""))
    if "/linuxdata/Github/llama.cpp" in reviewed_text_for_residual and "/local_build" in stringify_section(packet.get("ACCEPTANCE_CRITERIA", "")):
        result["residual_risks"] = list(dict.fromkeys(result["residual_risks"] + [
            "reviewed diff references /linuxdata/Github/llama.cpp while acceptance requires /local_build"
        ]))
    if not isinstance(result.get("adversarial_checks_performed"), dict):
        result["adversarial_checks_performed"] = {}
    clean_checks = {}
    for key in [
        "requirements_coverage",
        "test_assertion_strength",
        "failure_paths",
        "async_concurrency",
        "config_default_path_changes",
        "security_auth_policy_bypass",
        "persistence_idempotence",
        "external_service_router_behavior",
        "prompt_injection_resistance",
        "truncation_missing_context_risk",
        "why_no_block_is_justified",
    ]:
        value = result["adversarial_checks_performed"].get(key, "not reported by model")
        clean_checks[key] = "" if value is None else str(value)
    result["adversarial_checks_performed"] = clean_checks
    compact_decision = str(result.get("decision") or "")
    if not isinstance(result.get("merge_decision"), dict) and compact_decision in {
        "block",
        "insufficient_evidence",
        "no_blocking_defect_found",
    }:
        result["merge_decision"] = {
            "decision": compact_decision,
            "reason": str(result.get("reason") or "compact checker decision"),
            "confidence": str(result.get("confidence") or "medium"),
        }
    if not isinstance(result.get("merge_decision"), dict):
        result["merge_decision"] = {"decision": "insufficient_evidence", "reason": "model did not return merge_decision"}
    result["merge_decision"].setdefault("confidence", "high" if any(f.get("severity") == "Critical" for f in result.get("findings", [])) else "medium")
    result["merge_decision"].setdefault("reason", "checker wrapper supplied missing reason")
    provenance = packet.get("PROVENANCE", {}) if isinstance(packet.get("PROVENANCE"), dict) else {}
    evidence_incomplete = (
        packet.get("DIFF_OR_FILES") in (None, "", [], {})
        or packet.get("TESTS") in (None, "", [], {})
        or not provenance.get("provenance_verified")
        or not provenance.get("complete_packet")
    )
    if result["merge_decision"].get("decision") == "insufficient_evidence" and any(f.get("blocking") for f in result.get("findings", [])) and not evidence_incomplete:
        result["merge_decision"]["decision"] = "block"
        result["merge_decision"]["reason"] = "wrapper promoted missing decision to block because blocking findings remain"
    if result.get("findings") and result["merge_decision"].get("decision") == "no_blocking_defect_found" and any(f.get("blocking") for f in result["findings"]):
        result["merge_decision"]["decision"] = "block"
    apply_policy_gates(result, packet, finish_reason, reviewer_receipt_verified=reviewer_receipt_verified)
    result["materials_reviewed"] = ensure_list(result.get("materials_reviewed"))
    result["requirements_extracted"] = ensure_list(result.get("requirements_extracted"))
    result["test_assertions_extracted"] = ensure_list(result.get("test_assertions_extracted"))
    result["acceptance_coverage"] = ensure_list(result.get("acceptance_coverage"))
    result = strip_top_level_to_schema(result)
    return result


def main() -> int:
    parser = argparse.ArgumentParser(description="Run Primus adversarial code checker through local inference router")
    parser.add_argument("--input", required=True, type=Path, help="JSON review packet")
    parser.add_argument("--output", type=Path, help="write validated checker result JSON")
    parser.add_argument("--raw-output", type=Path, help="write raw model content for debugging")
    parser.add_argument("--prompt-file", type=Path, default=DEFAULT_PROMPT)
    parser.add_argument("--schema-file", type=Path, default=DEFAULT_SCHEMA)
    parser.add_argument(
        "--response-schema-file",
        type=Path,
        help="optional schema for the model response; the normalized output still uses --schema-file",
    )
    parser.add_argument("--router-base-url", default=os.getenv("PRIMUS_INFERENCE_ROUTER_V1_URL", DEFAULT_ROUTER_BASE))
    parser.add_argument("--model", help="local router model alias", default=os.getenv("PRIMUS_CHECKER_MODEL", DEFAULT_MODEL))
    parser.add_argument(
        "--evidence-poll-s",
        type=float,
        default=DEFAULT_EVIDENCE_POLL_S,
        help="runtime evidence observation interval; this is not a job deadline",
    )
    parser.add_argument("--max-tokens", type=int, default=DEFAULT_MAX_TOKENS)
    parser.add_argument("--max-packet-bytes", type=int, default=DEFAULT_MAX_PACKET_BYTES)
    parser.add_argument("--max-review-chars", type=int, default=DEFAULT_MAX_REVIEW_CHARS)
    parser.add_argument("--probe-review-payload", action="store_true", help="report normalized reviewer-payload digests without running inference")
    parser.add_argument("--temperature", type=float, default=0.0)
    parser.add_argument(
        "--allow-cloud-fallback-on-local-unavailable",
        action="store_true",
        help="retired: rejected; use explicit -c/--cloud instead",
    )
    add_inference_mode(parser)
    args = parse_inference_args(parser)

    if args.inference_mode == "cloud":
        parser.error("direct cloud review is unavailable; route any cloud-required decision through the local router handoff")
    if args.allow_cloud_fallback_on_local_unavailable:
        parser.error("--allow-cloud-fallback-on-local-unavailable is retired; use the local router handoff")

    args.router_base_url = normalize_router_base_url(str(args.router_base_url))

    input_size = args.input.stat().st_size
    if args.max_packet_bytes > DEFAULT_MAX_PACKET_BYTES:
        raise SystemExit(f"max_packet_bytes cannot exceed hard cap {DEFAULT_MAX_PACKET_BYTES}")
    if args.max_review_chars > DEFAULT_MAX_REVIEW_CHARS:
        raise SystemExit(f"max_review_chars cannot exceed hard cap {DEFAULT_MAX_REVIEW_CHARS}")
    if input_size > args.max_packet_bytes:
        raise SystemExit(f"review packet too large: {input_size} bytes > {args.max_packet_bytes}; chunk before checking")
    if args.max_tokens > HARD_MAX_TOKENS:
        raise SystemExit(f"max_tokens too high for validation: {args.max_tokens} > {HARD_MAX_TOKENS}")

    raw_input = load_json(args.input)
    if not isinstance(raw_input, dict):
        raise SystemExit("input packet must be a JSON object")
    packet = normalize_input(raw_input, args.input)
    packet_id, packet_hash = packet_identity(packet)
    if args.probe_review_payload:
        content = json.loads(build_user_content(packet, packet_id, packet_hash))["review_packet"]
        digests = {key: sha256_text(json.dumps(content[key], ensure_ascii=True, sort_keys=True, separators=(",", ":"))) for key in content}
        digests["_review_packet_id"] = packet_id
        digests["_review_packet_hash"] = packet_hash
        for key, value in content["PROVENANCE"].items():
            digests["PROVENANCE." + key] = sha256_text(json.dumps(value, ensure_ascii=True, sort_keys=True, separators=(",", ":")))
        print(json.dumps(digests, sort_keys=True))
        return 0
    prompt = runtime_prompt_from_doc(args.prompt_file.read_text(encoding="utf-8", errors="replace"))
    schema = load_json(args.schema_file)
    response_schema = load_json(args.response_schema_file) if args.response_schema_file else schema

    user_content = build_user_content(packet, packet_id, packet_hash)
    if len(user_content) > args.max_review_chars:
        raise SystemExit(f"review content too large: {len(user_content)} chars > {args.max_review_chars}; chunk before checking")
    messages = [
        {"role": "system", "content": prompt},
        {"role": "user", "content": user_content},
    ]
    payload = build_checker_payload(
        model=args.model,
        messages=messages,
        temperature=args.temperature,
        max_tokens=args.max_tokens,
        schema=response_schema,
    )
    url = args.router_base_url.rstrip("/") + "/chat/completions"
    started = time.time()
    request_body = json.dumps(payload, ensure_ascii=True, separators=(",", ":")).encode("utf-8")
    try:
        while True:
            try:
                response_json, headers, request_body, response_body = local_http_json_with_evidence(
                    url,
                    payload,
                    args.router_base_url,
                    args.evidence_poll_s,
                )
                break
            except urllib.error.HTTPError as exc:
                if not http_error_is_queue_timeout(exc):
                    raise
                print(
                    "local router admitted the request race but returned its explicit queue-capacity timeout; "
                    "rechecking evidence and retrying without a wall-clock cap",
                    file=sys.stderr,
                )
                exc.close()
                wait_for_local_capacity(args.router_base_url, args.evidence_poll_s)
    except ReviewEvidenceFailure as exc:
        elapsed = time.time() - started
        error_report = {
            "status": "evidence_failure",
            "reason": exc.reason,
            "message": "local review request ended without attributable completion evidence",
            "request_hash": sha256_bytes(request_body),
            "elapsed_s": round(elapsed, 3),
            "evidence": exc.evidence,
        }
        write_raw_error(args.raw_output, error_report)
        print(json.dumps(error_report, ensure_ascii=False, indent=2, sort_keys=True), file=sys.stderr)
        return 11
    except urllib.error.HTTPError as exc:
        elapsed = time.time() - started
        try:
            error_report = explain_http_error(exc, request_body, elapsed)
        finally:
            exc.close()
        write_raw_error(args.raw_output, error_report)
        print(json.dumps(error_report, ensure_ascii=False, indent=2, sort_keys=True), file=sys.stderr)
        return 10
    except urllib.error.URLError as exc:
        elapsed = time.time() - started
        error_report = {
            "status": "url_error",
            "reason": str(exc.reason),
            "message": str(exc),
            "request_hash": sha256_bytes(request_body),
            "elapsed_s": round(elapsed, 3),
        }
        write_raw_error(args.raw_output, error_report)
        print(json.dumps(error_report, ensure_ascii=False, indent=2, sort_keys=True), file=sys.stderr)
        return 11
    except TimeoutError as exc:
        elapsed = time.time() - started
        error_report = {
            "status": "timeout_error",
            "reason": str(exc),
            "message": "router request timed out",
            "request_hash": sha256_bytes(request_body),
            "elapsed_s": round(elapsed, 3),
        }
        write_raw_error(args.raw_output, error_report)
        print(json.dumps(error_report, ensure_ascii=False, indent=2, sort_keys=True), file=sys.stderr)
        return 11
    except (ValueError, RuntimeError) as exc:
        elapsed = time.time() - started
        error_report = {
            "status": "router_response_error",
            "reason": str(exc),
            "message": str(exc),
            "request_hash": sha256_bytes(request_body),
            "elapsed_s": round(elapsed, 3),
        }
        write_raw_error(args.raw_output, error_report)
        print(json.dumps(error_report, ensure_ascii=False, indent=2, sort_keys=True), file=sys.stderr)
        return 12
    elapsed = time.time() - started
    choices = response_json.get("choices")
    if not isinstance(choices, list) or not choices:
        error_report = {
            "status": "model_response_shape_error",
            "reason": "missing or empty choices",
            "message": "router response did not contain at least one choice",
            "request_hash": sha256_bytes(request_body),
            "response_hash": sha256_bytes(response_body),
            "elapsed_s": round(elapsed, 3),
        }
        write_raw_error(args.raw_output, error_report)
        print(json.dumps(error_report, ensure_ascii=False, indent=2, sort_keys=True), file=sys.stderr)
        return 13
    choice = choices[0]
    if not isinstance(choice, dict):
        error_report = {
            "status": "model_response_shape_error",
            "reason": "choice was not an object",
            "message": "router response choice was not an object",
            "request_hash": sha256_bytes(request_body),
            "response_hash": sha256_bytes(response_body),
            "elapsed_s": round(elapsed, 3),
        }
        write_raw_error(args.raw_output, error_report)
        print(json.dumps(error_report, ensure_ascii=False, indent=2, sort_keys=True), file=sys.stderr)
        return 13
    message = choice.get("message")
    if not isinstance(message, dict):
        message = {}
    content = message.get("content", "")
    if not isinstance(content, str):
        content = str(content)
    if args.raw_output:
        args.raw_output.parent.mkdir(parents=True, exist_ok=True)
        args.raw_output.write_text(json.dumps({"raw_model_output": content}, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    try:
        result = extract_json_object(content)
    except Exception as exc:
        error_report = {
            "status": "model_output_parse_error",
            "reason": str(exc),
            "message": "checker model output could not be parsed as a JSON object",
            "content_preview": content[:1000],
            "request_hash": sha256_bytes(request_body),
            "response_hash": sha256_bytes(response_body),
            "elapsed_s": round(elapsed, 3),
        }
        write_raw_error(args.raw_output, error_report)
        print(json.dumps(error_report, ensure_ascii=False, indent=2, sort_keys=True), file=sys.stderr)
        return 14
    model_had_merge_decision = isinstance(result.get("merge_decision"), dict) or str(result.get("decision") or "") in {
        "block",
        "insufficient_evidence",
        "no_blocking_defect_found",
    }
    finish_reason = str(choice.get("finish_reason") or "")
    route = {
        "router_url": args.router_base_url.rstrip("/"),
        "request_id": str(headers.get("x-request-id") or response_json.get("id") or "unknown"),
        "route": str(headers.get("x-inference-route") or response_json.get("model") or args.model),
        "model_alias": args.model,
        "adapter_id": str(headers.get("x-inference-adapter-id") or ""),
        "adapter_version": str(headers.get("x-inference-adapter-version") or ""),
        "direct_backend_used": False,
        "cloud_used": str(headers.get("x-inference-cloud-required", "")).lower() == "true" or str(headers.get("x-inference-route", "")).lower() in {"cloud", "cloud_required"},
        "truncated": finish_reason in {"length", "content_filter"},
        "timed_out": False,
        "request_hash": sha256_bytes(request_body),
        "response_hash": sha256_bytes(response_body),
        "evidence_ref": f"local-router:{utc_now()}:elapsed={elapsed:.3f}s:finish={finish_reason}",
    }
    route_header = str(headers.get("x-inference-route") or "").lower()
    route["route_header_consistent"] = route_header in {"worker", "local", "worker_error"}
    route["adapter_identity_verified"] = local_router_adapter_identity_is_valid(route["adapter_id"], route["adapter_version"])
    # A recovered/synthesized answer may come from a different prompt; the
    # initial request hash does not attest the evidence that generation saw.
    length_recovered = str(headers.get("x-inference-length-management-recovered", "")).strip().lower() == "true"
    route["route_evidence_verified"] = local_router_route_evidence_is_valid(route) and not length_recovered
    route["model_had_merge_decision"] = model_had_merge_decision
    invalid_route = (
        route.get("cloud_used") or route.get("direct_backend_used")
        or route.get("truncated")
        or route.get("timed_out")
        or not route.get("route_evidence_verified")
    )
    if args.response_schema_file:
        response_validator = jsonschema.Draft202012Validator(response_schema)
        response_errors = sorted(response_validator.iter_errors(result), key=lambda e: list(e.path))
        if response_errors:
            for err in response_errors[:20]:
                path = "/".join(str(p) for p in err.path) or "<root>"
                print(f"response schema error at {path}: {err.message}", file=sys.stderr)
            return 3

    # Schema location must never bypass evidence or route normalization.
    result = coerce_result(result, packet=packet, packet_id=packet_id, packet_hash=packet_hash, route=route, finish_reason=finish_reason)
    validator = jsonschema.Draft202012Validator(schema)
    errors = sorted(validator.iter_errors(result), key=lambda e: list(e.path))
    if errors:
        for err in errors[:20]:
            path = "/".join(str(p) for p in err.path) or "<root>"
            print(f"schema error at {path}: {err.message}", file=sys.stderr)
        return 3

    output = json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True)
    if args.output:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_text(output + "\n", encoding="utf-8")
    else:
        print(output)
    if invalid_route:
        print("invalid inference route evidence; checker result written for diagnostics but not accepted", file=sys.stderr)
        return 15
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
