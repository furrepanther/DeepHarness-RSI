def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def sha256_text(value: str) -> str:
    return hashlib.sha256(value.encode("utf-8")).hexdigest()


def sha256_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def load_json(path: Path) -> Any:
    with path.open("r", encoding="utf-8") as f:
        return json.load(f)


def normalize_input(raw: dict[str, Any], source_path: Path) -> dict[str, Any]:
    def get(*names: str, default: Any = "") -> Any:
        for name in names:
            if name in raw:
                return raw[name]
        return default

    provenance = get("PROVENANCE", "provenance", default={})
    if not isinstance(provenance, dict):
        provenance = {"raw": provenance}
    provenance.setdefault("repo_or_scope", str(source_path))
    provenance.setdefault("base_revision", "unknown")
    provenance.setdefault("artifact_refs", [])
    provenance.setdefault("provenance_verified", False)
    provenance.setdefault("complete_packet", False)

    normalized = {
        "TASK": get("TASK", "task"),
        "ACCEPTANCE_CRITERIA": get("ACCEPTANCE_CRITERIA", "acceptance_criteria"),
        "DIFF_OR_FILES": get("DIFF_OR_FILES", "diff_or_files"),
        "TESTS": get("TESTS", "tests"),
        "KNOWN_CONSTRAINTS": get("KNOWN_CONSTRAINTS", "known_constraints"),
        "OUT_OF_SCOPE": get("OUT_OF_SCOPE", "out_of_scope"),
        "PROVENANCE": provenance,
    }
    if "SDLC_REVIEW_EVIDENCE" in raw:
        normalized["SDLC_REVIEW_EVIDENCE"] = raw["SDLC_REVIEW_EVIDENCE"]
    return normalized


def stringify_section(value: Any) -> str:
    if isinstance(value, str):
        return value
    return json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True)


def iter_string_leaves(value: Any, path: str) -> list[tuple[str, str]]:
    leaves: list[tuple[str, str]] = []
    if isinstance(value, str):
        return [(path, value)]
    if isinstance(value, dict):
        for key, child in value.items():
            child_path = f"{path}.{key}" if path else str(key)
            leaves.extend(iter_string_leaves(child, child_path))
    elif isinstance(value, list):
        for index, child in enumerate(value):
            child_path = f"{path}[{index}]"
            leaves.extend(iter_string_leaves(child, child_path))
    return leaves


